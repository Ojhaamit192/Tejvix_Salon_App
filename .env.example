# Copy this file to ".env" for local testing with `netlify dev`.
# In production, set these as Environment Variables in the Netlify dashboard
# instead (Site settings → Environment variables) — never commit real
# credentials to GitHub.

# From your Supabase project: Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The "service_role" key (NOT the anon/public key) — Settings → API → Project API keys
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# From fast2sms.com/dashboard/dev-api after signing up
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# From Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# From RazorpayX Dashboard (a separate product from the payment gateway
# above) — the current/virtual account payouts to salons are paid FROM.
# Uses the same RAZORPAY_KEY_ID/SECRET above for authentication.
RAZORPAY_X_ACCOUNT_NUMBER=your_razorpayx_account_number_here

# A password you make up yourself — protects owner-dashboard.html
# (the cross-salon view showing data for every salon on the platform).
OWNER_PASSWORD=choose_a_strong_password_here
